        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp; Solid: MVP flow&amp;nbsp;&amp;nbsp; Dashed: optional/deferred component or integration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D7DEE7;fontColor=#526579;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
