        </mxCell>
        <mxCell id="note" value="Security boundary: the API derives tenant access from verified identity and membership. PostgreSQL RLS is defense in depth; client-side filtering never authorizes access." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFBE6;strokeColor=#D6B656;fontColor=#51451D;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
